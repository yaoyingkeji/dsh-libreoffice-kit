+void SkiaSalGraphicsImpl::bindGraphiteTarget(sk_sp<SkSurface> surface)
+{
+    if (!isOffscreen() || !surface || !surface->getCanvas()->recorder()
+        || surface->width() != GetWidth() || surface->height() != GetHeight())
+        throw std::runtime_error("Graphite target must match the offscreen output device");
+    destroySurface();
+    mSurface = std::move(surface);
+    mScaling = 1;
+    mIsGPU = true;
+    mClipRegion = vcl::Region(tools::Rectangle(0, 0, GetWidth(), GetHeight()));
+    mDirtyRect = SkIRect::MakeWH(GetWidth(), GetHeight());
+    setCanvasScalingAndClipping();
+    mFlush->Stop();
+}
+
+void SkiaSalGraphicsImpl::finishGraphiteTarget()
+{
+    // WITHOUT_ALPHA devices expose opaque pixels even where paths leave alpha below one.
+    mSurface->getCanvas()->restoreToCount(1);
+    mSurface->getCanvas()->drawColor(SK_ColorBLACK, SkBlendMode::kDstATop);
+    mSurface->getCanvas()->save();
+    mSurface->getCanvas()->save();
+}
+
+void SkiaSalGraphicsImpl::releaseGraphiteTarget()
+{
+    mFlush->Stop();
+    destroySurface();
+}
