+Player::~Player()
+{
+    // Queued MFPlay work items may still dispatch a callback; detach first, so
+    // they can no longer reach this object while its members are destroyed.
+    if (mpCallback)
+        mpCallback->detachOwner();
+
+    if( mnFrameWnd )
+        ::DestroyWindow( mnFrameWnd );
+
+    if (g_pPlayer)
+        g_pPlayer->Shutdown();
+    SafeRelease(&g_pPlayer);
+
+    if (mpCallback)
+    {
+        mpCallback->Release();
+        mpCallback = nullptr;
+    }
+}
