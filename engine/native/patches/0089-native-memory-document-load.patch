+
+// The seekable stream owns its bytes for as long as the document retains it.
+extern "C" SAL_DLLPUBLIC_EXPORT LibreOfficeKitDocument* dsh_native_document_load_bytes(
+    LibreOfficeKit* pThis, const unsigned char* pBytes, int nLength, const char* pOptions)
+{
+    if (!pBytes || nLength <= 0)
+    {
+        static_cast<LibLibreOffice_Impl*>(pThis)->maLastExceptionMsg = u"Document bytes are empty."_ustr;
+        return nullptr;
+    }
+    uno::Sequence<sal_Int8> aBytes(reinterpret_cast<const sal_Int8*>(pBytes), nLength);
+    uno::Reference<io::XInputStream> xInput = new comphelper::SequenceInputStream(aBytes);
+    return lo_documentLoadWithStream(pThis, "private:stream", pOptions, xInput);
